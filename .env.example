# Canonical site origin. Used for metadata (canonical, og:url, og:image), sitemap.xml, robots.txt, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://yogawritecode.com

# Google Tag Manager container ID. Loads only after the visitor accepts analytics and fires the GA4 tag. Set to an empty value to disable it.
NEXT_PUBLIC_GTM_CONTAINER_ID=GTM-K8MFHGSC

# Microsoft Clarity project ID. Loads only after the visitor accepts analytics. Set to an empty value to disable it.
NEXT_PUBLIC_CLARITY_PROJECT_ID=yo9d18nwgq

# PostHog (analytics, consent-gated). HOST defaults to the /ingest reverse proxy.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=/ingest

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Use the project's anon key (or the newer publishable key if Supabase gives you that name).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI provider: "mock" or "bedrock"
AI_MODE=mock

# Resend (transactional signup email). Both must be set or signup email is skipped.
# RESEND_FROM_EMAIL must be on a domain you have verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Yoga Write Code <hello@notifications.yogawritecode.com>

# Tavily (SERP/keyword enrichment for opportunities)
TAVILY_API_KEY=

# Paddle (billing). Environment is "sandbox" or "production".
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Price IDs are safe to expose; they are read server-side and passed to the client.
NEXT_PUBLIC_PADDLE_PRICE_ID_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_ID_YEARLY=

# Dodo Payments (billing). Signing secret from Dodo Dashboard → Developer → Webhooks.
# Required to verify webhook signatures in /api/webhooks/dodo.
DODO_PAYMENTS_WEBHOOK_KEY=

# Google OAuth (Search Console + Analytics read-only, /dashboard/analytics).
# Create OAuth client credentials in Google Cloud Console → APIs & Services →
# Credentials. Add this exact redirect URI (prod):
# https://app.yogawritecode.com/api/auth/google/callback
# Enable the Search Console API (and Analytics Data API if you add GA reads).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Long random string used to encrypt stored refresh tokens (AES-256-GCM).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_OAUTH_TOKEN_KEY=
# Optional override for local dev tunnels. Defaults to <origin>/api/auth/google/callback.
GOOGLE_OAUTH_REDIRECT_URI=
# Per-tier checkout links. Create Starter $9 / Pro $19 / Scale $40 products in Dodo,
# then paste their buy links here. Each falls back to the single live link if unset.
NEXT_PUBLIC_DODO_STARTER_LINK=
NEXT_PUBLIC_DODO_PRO_LINK=
NEXT_PUBLIC_DODO_SCALE_LINK=

# Bedrock (only when AI_MODE=bedrock)
AWS_REGION=ap-southeast-2
# Active Anthropic cross-region inference profile for Sydney.
BEDROCK_MODEL_ID=au.anthropic.claude-sonnet-4-5-20250929-v1:0
AWS_BEARER_TOKEN_BEDROCK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
